# Copy to .env.local for local development. Set the same values in Vercel for production.
# Never commit real values.

# Public base URL, no trailing slash. Used for sitemap, RSS, canonical URLs, magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Dashboard > Project Settings > API Keys (or `npx supabase status` locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Legacy anon key or the new sb_publishable_... key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy service_role key or the new sb_secret_... key. Server only: bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Dashboard > Developers > API keys. Use sk_test_... until launch.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# beehiiv: Settings > API. Server only. The signup form stays hidden until both are set.
BEEHIIV_API_KEY=
# The publication ID shown on the same page, e.g. pub_xxxxxxxx-xxxx-...
BEEHIIV_PUBLICATION_ID=
